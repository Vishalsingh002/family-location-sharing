# App Settings
APP_NAME=FamLocator
SECRET_KEY=generate_a_random_secret_hex_or_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Database Settings
# Default is SQLite file in project root:
DATABASE_URL=sqlite:///./family_locator.db
# For PostgreSQL (e.g. Render Postgres, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudinary CDN Configuration (For permanent cloud image hosting)
# Option 1: 1-Click Environment Variable (copied directly from Cloudinary Dashboard)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option 2: Individual variables
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
